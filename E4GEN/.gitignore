# E4GEN — global ** whitelist: repo root LICENSE, main.py, README.md, requirements.txt;
# Analysis, Baseline, Bash (whole tree allowed except Archived and Bash/run_timeseries_var_sweep.sh, see below),
# Figures, engine, Models, Utils, OUTPUT (.gitkeep + OUTPUT/toyexample_E4GEN/, see OUTPUT block), Config/Extreme, Final Result (partial),
# Data/Extreme_Data and Data/build_dataloader.py (see below); extend as needed.

# Global: ignore everything by default (!**/ required for subdirectory negation)
**
!**/

# This file must be tracked (otherwise ** hides root .gitignore)
!/.gitignore

# Repo root: commonly tracked files
!/LICENSE
!/main.py
!/result_analysis_visualization.ipynb
!/README.md
!/requirements.txt

# --- Analysis allowlist ---
!/Analysis/Paper Writing Picture/
!/Analysis/Paper Writing Picture/**
!/Analysis/Pictures/
!/Analysis/Pictures/**

# --- Baseline allowlist (whole tree) ---
!/Baseline/
!/Baseline/**

# --- Bash allowlist (whole tree) ---
!/Bash/
!/Bash/**

# --- Bash: do not track ---
/Bash/Archived/
/Bash/Archived/**
/Bash/run_timeseries_var_sweep.sh

# --- Figures allowlist (whole tree) ---
!/Figures/
!/Figures/**

# --- engine allowlist (whole tree) ---
!/engine/
!/engine/**

# --- Models allowlist (whole tree) ---
!/Models/
!/Models/**

# --- Utils allowlist (whole tree) ---
!/Utils/
!/Utils/**

# --- OUTPUT: default ignore all runs; track .gitkeep and toyexample_E4GEN example run ---
!/OUTPUT/
/OUTPUT/*
!/OUTPUT/.gitkeep
!/OUTPUT/toyexample_E4GEN/
!/OUTPUT/toyexample_E4GEN/**

## -- Checkpoint
# --- Checkpoint: default ignore runs; track .gitkeep only ---
!/Checkpoint/
/Checkpoint/*
!/Checkpoint/.gitkeep

# --- Config/Extreme: whole tree (do not open other paths under Config/) ---
!/Config/
!/Config/Extreme/
!/Config/Extreme/**

# --- Final Result: Results/ and two notebooks (paths with spaces) ---
!/Final Result/
!/Final Result/Results/
!/Final Result/Results/**
!/Final Result/Standard Metric.ipynb
!/Final Result/Standard Visualization.ipynb

# --- Data/Extreme_Data: only listed subtrees; exclude Origin Data under Weather ---
!/Data/
!/Data/Extreme_Data/

!/Data/Extreme_Data/ECG/
!/Data/Extreme_Data/ECG/**
/Data/Extreme_Data/ECG/Origin Data/
/Data/Extreme_Data/ECG/Origin Data/**

!/Data/Extreme_Data/Electricity/
!/Data/Extreme_Data/Electricity/**
/Data/Extreme_Data/Electricity/Origin Data/
/Data/Extreme_Data/Electricity/Origin Data/**


!/Data/Extreme_Data/Rainfall/
!/Data/Extreme_Data/Rainfall/**

!/Data/Extreme_Data/Temperature/
!/Data/Extreme_Data/Temperature/**

!/Data/Extreme_Data/toyexample_timeseries/
!/Data/Extreme_Data/toyexample_timeseries/**

!/Data/Extreme_Data/Transportation/
!/Data/Extreme_Data/Transportation/**
/Data/Extreme_Data/Transportation/Origin Data/
/Data/Extreme_Data/Transportation/Origin Data/**

!/Data/Extreme_Data/Weather/
!/Data/Extreme_Data/Weather/**
/Data/Extreme_Data/Weather/Origin Data/
/Data/Extreme_Data/Weather/Origin Data/**

!/Data/Extreme_Data/Wind/
!/Data/Extreme_Data/Wind/**

# --- Data: root script tracked ---
!/Data/build_dataloader.py

# --- Utils: not referenced upstream; keep locally but untrack ---
/Utils/discriminative_metric.py
/Utils/extreme_predictive_metric.py
/Utils/cross_correlation.py
/Utils/imputation_utils.py
/Utils/Data_utils/sine_dataset.py
/Utils/Data_utils/real_datasets.py
/Utils/Data_utils/mujoco_dataset.py
/Utils/Data_utils/eeg_dataset.py

# --- Final local exclusions for publishing SysEnergy ---
# Keep generated data, trained weights, caches, and local notebook checkpoints out of Git.
**/__pycache__/
**/*.py[cod]
**/.ipynb_checkpoints/
**/*.pt
**/*.pth
**/*.ckpt
**/*.joblib
**/*.pkl
**/*.pickle
**/*.npy
**/*.npz
**/*.parquet
**/*.jsonl
**/Output/
**/output/
**/outputs/
**/Results/
**/results/
**/*.log
