# Repo root — OS, Python, env, generated artifacts; SynEnergy code tracked by default.

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments and local secrets
.env
.env.*
!.env.example
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Logs and temporary files
*.log
*.tmp
*.temp

# Large / generated ML artifacts (training outputs, weights, arrays)
*.pt
*.pth
*.ckpt
*.joblib
*.pkl
*.pickle
*.npy
*.npz

# Track bundled FL training data so others can run out of the box
!/SynEnergy/Data/Power/
!/SynEnergy/Data/Power/**

# Analysis outputs generated locally
/Analysis/Result/
/Analysis/Plot/
/Analysis/Dataset/
/Analysis/*.csv

# SynEnergy: training runs, checkpoints, test data
/SynEnergy/Checkpoint/*
!/SynEnergy/Checkpoint/.gitkeep
/SynEnergy/OUTPUT/*
!/SynEnergy/OUTPUT/.gitkeep
/SynEnergy/Baseline/Results/
/SynEnergy/Data/Test/

# SynEnergy: local-only paths (see also SynEnergy/.gitignore)
/SynEnergy/Data/Data_Check.ipynb
/SynEnergy/NYCA/

# Local archives / compressed data
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
